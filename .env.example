# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bar_arbolada
DB_USER=bar_arbolada
DB_PASSWORD=CHANGE_ME

# Constructed connection string (used by SQLAlchemy + Alembic)
# DATABASE_URL=postgresql://bar_arbolada:CHANGE_ME@localhost:5432/bar_arbolada

# Daily email import source
# Recommended primary setup: business-owned IMAP inbox
EMAIL_SOURCE=imap
EMAIL_STAGING_DIR=
EMAIL_IMPORT_LOOKBACK_DAYS=7

# IMAP settings (required when EMAIL_SOURCE=imap)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_SUBJECT_FILTER=

# Read-only manager API
# Generate a long random value and keep it server-side. Never embed it in browser JS.
MANAGER_API_TOKEN=
# Dedicated read-only PostgreSQL connection for the manager API process.
# MANAGER_DATABASE_URL=postgresql://bar_manager_read:CHANGE_ME@localhost:5432/bar_arbolada
# Comma-separated hostnames accepted by TrustedHostMiddleware.
MANAGER_API_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave empty in production. API documentation is disabled by default.
MANAGER_API_ENABLE_DOCS=
# Comma-separated exact HTTPS origins allowed to call the API.
# Prefer a Sites server-side proxy so this can remain empty.
MANAGER_API_ALLOWED_ORIGINS=
