# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bar_arbolada
DB_USER=bar_arbolada
DB_PASSWORD=CHANGE_ME

# Constructed connection string (used by SQLAlchemy + Alembic)
# DATABASE_URL=postgresql://bar_arbolada:CHANGE_ME@localhost:5432/bar_arbolada

# Daily email import source
# Recommended primary setup: business-owned IMAP inbox
EMAIL_SOURCE=imap
EMAIL_STAGING_DIR=
EMAIL_IMPORT_LOOKBACK_DAYS=7

# IMAP settings (required when EMAIL_SOURCE=imap)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_SUBJECT_FILTER=
